meta {
  name: Update tenant
  type: http
  seq: 5
}

put {
  url: {{BASE_URL}}/tenant/{{tenant_id}}
  body: json
  auth: inherit
}

params:path {
  tenant_id: acme-corp
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "label": "ACME Corp Inc.",
    "description": "Updated description",
    "data": {
      "email": "support@acmecorp.test",
      "department": "Engineering"
    }
  }
}

docs {
  Update the details of an existing tenant.
  
  Only fields provided in the request body will be updated.
}
