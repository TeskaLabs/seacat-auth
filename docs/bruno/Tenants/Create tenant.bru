meta {
  name: Create tenant
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/tenant
  body: json
  auth: inherit
}

params:query {
  ~assign_me: false
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "acme-corp",
    "label": "ACME Corporation",
    "description": "Primary tenant for ACME Corp",
    "data": {
      "email": "admin@acme.test",
      "department": "IT"
    }
  }
}

docs {
  Create a new tenant with the specified ID and metadata.
  
  The tenant ID must be unique and cannot be changed once created.
  Use `assign_me=true` query parameter to automatically grant yourself access to the tenant.
}
