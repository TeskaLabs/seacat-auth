meta {
  name: Delete tenant
  type: http
  seq: 6
}

delete {
  url: {{BASE_URL}}/tenant/{{tenant_id}}
  body: none
  auth: inherit
}

params:path {
  tenant_id: acme-corp
}

docs {
  Delete a tenant and all associated data.
  
  This action permanently removes the tenant, including all its roles and role assignments.
  This action cannot be undone.
}
