meta {
  name: Create role
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/admin/role/{{tenant}}/{{role_name}}
  body: json
  auth: inherit
}

params:path {
  tenant: acme-corp
  role_name: user
}

params:query {
  ~copy: 
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "label": "Standard User",
    "description": "Standard user with basic access",
    "resources": [
      "authz:tenant:access",
      "authz:tenant:read"
    ],
    "propagated": false
  }
}

docs {
  Create a new role in the specified tenant.
  
  The role ID will be {tenant}/{role_name}.
  Use the `copy` query parameter to copy resources from an existing role.
}
