meta {
  name: Register client
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/admin/client
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "client_name": "My Application",
    "redirect_uris": ["https://myapp.example.com/callback"],
    "application_type": "web",
    "grant_types": ["authorization_code"],
    "response_types": ["code"],
    "token_endpoint_auth_method": "client_secret_basic"
  }
}

docs {
  Register a new OAuth2/OIDC client application.
  
  For confidential clients, a client secret is automatically generated and returned in the response.
  
  Available grant_types: authorization_code, refresh_token, client_credentials
  Available response_types: code
  Available token_endpoint_auth_method: none, client_secret_basic, client_secret_post
}
