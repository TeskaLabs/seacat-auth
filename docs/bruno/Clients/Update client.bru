meta {
  name: Update client
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/admin/client/{{client_id}}
  body: json
  auth: inherit
}

params:path {
  client_id: my-app-client-id
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "client_name": "Updated Application Name",
    "redirect_uris": ["https://new.example.com/callback"],
    "client_uri": "https://new.example.com"
  }
}

docs {
  Update an existing OAuth2/OIDC client.
  
  Only provided fields will be updated. The client_id cannot be changed.
}
